{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TickerOutput",
  "description": "Extended ticker output with sector-inferred companies",
  "type": "object",
  "properties": {
    "mappings": {
      "type": "array",
      "description": "Direct company-to-ticker mappings (existing)",
      "items": {
        "$ref": "#/definitions/TickerMapping"
      }
    },
    "sectors": {
      "type": "array",
      "description": "Identified sectors from text analysis",
      "items": {
        "$ref": "#/definitions/Sector"
      }
    },
    "inferred_tickers": {
      "type": "array",
      "description": "Companies inferred from sector analysis",
      "items": {
        "$ref": "#/definitions/InferredTicker"
      }
    }
  },
  "required": ["mappings"],
  "definitions": {
    "ConfidenceLevel": {
      "type": "string",
      "enum": ["high", "medium", "low"],
      "description": "Qualitative confidence level"
    },
    "TickerMapping": {
      "type": "object",
      "properties": {
        "company": {
          "type": "string",
          "description": "Company name from EntityOutput"
        },
        "symbol": {
          "type": "string",
          "pattern": "^[A-Z0-9.\\-]{1,12}$",
          "description": "Resolved ticker symbol"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Mapping confidence (numeric)"
        },
        "reasoning": {
          "type": "string",
          "description": "Why this mapping"
        }
      },
      "required": ["company", "symbol", "confidence", "reasoning"]
    },
    "Sector": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Sector name (e.g., semiconductors)"
        },
        "confidence": {
          "$ref": "#/definitions/ConfidenceLevel"
        },
        "sub_sectors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Supply chain layers or sub-industries"
        }
      },
      "required": ["name", "confidence"]
    },
    "InferredTicker": {
      "type": "object",
      "properties": {
        "company_name": {
          "type": "string",
          "description": "Full company name"
        },
        "symbol": {
          "type": "string",
          "pattern": "^[A-Z0-9.\\-]{1,12}$",
          "description": "Ticker symbol with exchange suffix"
        },
        "sector": {
          "type": "string",
          "description": "Which sector this company belongs to"
        },
        "relevance_explanation": {
          "type": "string",
          "maxLength": 200,
          "description": "Why this company was inferred"
        },
        "confidence": {
          "$ref": "#/definitions/ConfidenceLevel"
        },
        "market_cap_tier": {
          "type": "string",
          "enum": ["large", "mid", "small"],
          "description": "Company size category"
        },
        "supply_chain_layer": {
          "type": "string",
          "description": "Position in value chain (optional)"
        },
        "verified": {
          "type": "boolean",
          "default": true,
          "description": "Whether yfinance verification succeeded"
        }
      },
      "required": ["company_name", "symbol", "sector", "relevance_explanation", "confidence", "market_cap_tier"]
    }
  }
}
